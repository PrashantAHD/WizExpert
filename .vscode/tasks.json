{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "WizExpert: Workflow console (auto-reload)",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "wizexpert.console.dev",
        "--workspace",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": false
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
